# Copy to .env for local development. All values below are the defaults.

# SQLAlchemy database URL. On Render this points at a path inside the container.
DATABASE_URL=sqlite:///./fireflies.db

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Regex for additional allowed origins (used for Vercel preview deployments).
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Load the seed meetings at startup when the database has none.
SEED_ON_STARTUP=true
